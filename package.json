{
  "name": "ultimate-scraper",
  "version": "0.1.0",
  "description": "Google SERP + universal web scraper (Crawlee). Works locally and as an Apify Actor.",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "build": "tsc",
